@page
@model IndexModel
@{
    var artists = Model.TrackingInformation.Artists;
    var playlists = Model.TrackingInformation.Playlists;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SpotCrate</title>
    <link rel="icon" href="~/favicon/favicon.ico" sizes="any" />
    <link rel="icon" href="~/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="~/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tracking.css" asp-append-version="true" />
</head>
<body>
    <main class="shell">
        <section class="hero">
            <div class="hero-topline">
                <nav class="resource-links" aria-label="Project links">
                    <a href="https://github.com/pjmeca/spotcrate" target="_blank" rel="noopener noreferrer" aria-label="Open GitHub repository">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.21.09 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" /></svg>
                        GitHub
                    </a>
                    <a href="https://spotcrate.pjmeca.com" target="_blank" rel="noopener noreferrer" aria-label="Open documentation">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5A2.5 2.5 0 0 1 7.5 1H21v18H7.5A2.5 2.5 0 0 0 5 21.5v-18Zm2.5-.5A.5.5 0 0 0 7 3.5v14.55c.17-.03.33-.05.5-.05H19V3H7.5ZM3 5h2v16.5A2.5 2.5 0 0 0 7.5 24H21v-2H7.5a.5.5 0 0 1 0-1H21v-2H7.5A4.48 4.48 0 0 0 5 19.76V5H3Z" /></svg>
                        Docs
                    </a>
                </nav>
            </div>
            <div class="hero-title-row">
                <div class="hero-branding">
                    <div class="brand-lockup" aria-label="SpotCrate">
                        <img src="~/isotype.webp" alt="" class="hero-logo" />
                        <span class="brand-wordmark"><span>Spot</span><span>Crate</span></span>
                    </div>
                    <p>Tune the artists and playlists stored in <code>tracking.yaml</code>, then let the scheduled downloader keep your library moving.</p>
                </div>
                <div class="status-pill @(Model.IsTrackingFileWritable ? "status-ok" : "status-warning")">
                    @(Model.IsTrackingFileWritable ? "Writable" : "Read-only")
                </div>
                <nav class="mobile-resource-links" aria-label="Project links">
                    <a href="https://github.com/pjmeca/spotcrate" target="_blank" rel="noopener noreferrer" aria-label="Open GitHub repository">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.21.09 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z" /></svg>
                    </a>
                    <a href="https://spotcrate.pjmeca.com" target="_blank" rel="noopener noreferrer" aria-label="Open documentation">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5A2.5 2.5 0 0 1 7.5 1H21v18H7.5A2.5 2.5 0 0 0 5 21.5v-18Zm2.5-.5A.5.5 0 0 0 7 3.5v14.55c.17-.03.33-.05.5-.05H19V3H7.5ZM3 5h2v16.5A2.5 2.5 0 0 0 7.5 24H21v-2H7.5a.5.5 0 0 1 0-1H21v-2H7.5A4.48 4.48 0 0 0 5 19.76V5H3Z" /></svg>
                    </a>
                </nav>
            </div>
        </section>

        @if (!Model.IsTrackingFileWritable)
        {
            <section class="warning-banner" role="alert">
                <strong><code>tracking.yaml</code> does not appear to be writable.</strong>
                <span>You can still view tracked artists and playlists, but changes may not be saved. If you are using Docker, mount <code>/app/tracking.yaml</code> without <code>:ro</code> to enable editing.</span>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AlertMessage))
        {
            <section class="alert @(Model.AlertIsSuccess ? "alert-success" : "alert-error")" role="alert">
                @Model.AlertMessage
            </section>
        }

        <section class="panel">
            <div class="tabs" role="tablist" aria-label="Tracking sections">
                <button class="tab active" type="button" data-tab-button="artists" role="tab" aria-selected="true">Artists (@artists.Count)</button>
                <button class="tab" type="button" data-tab-button="playlists" role="tab" aria-selected="false">Playlists (@playlists.Count)</button>
            </div>

            <section class="tab-panel active" data-tab-panel="artists" role="tabpanel">
                <div class="section-header">
                    <div>
                        <h2>Artists</h2>
                        <p>Track Spotify artists so their albums, singles, and new releases can be downloaded into your library.</p>
                        <div class="order-toolbar" aria-label="Artist order">
                            <div class="order-toggle-row">
                                <span>Order:</span>
                                <span>A-Z</span>
                                <label class="order-switch">
                                    <input type="checkbox" data-order-toggle checked />
                                    <span aria-hidden="true"></span>
                                </label>
                                <span>YAML</span>
                                <small><em>Drag items in YAML mode to save a new file order.</em></small>
                            </div>
                        </div>
                    </div>
                    <button class="primary-action" type="button" data-open-editor data-entry-type="Artist">+ Add artist</button>
                </div>

                <form method="post" asp-page-handler="Reorder" class="reorder-form" data-reorder-form data-entry-type="Artist">
                    <input type="hidden" name="ReorderEntryType" value="Artist" />
                    <input type="hidden" name="OrderedIndexes" data-ordered-indexes />
                    <input type="hidden" name="OrderedEntries" data-ordered-entries />
                    <div class="entry-list" data-entry-list data-entry-type="Artist">
                    @if (artists.Count == 0)
                    {
                        <p class="empty-state">No tracked artists yet.</p>
                    }
                    @for (var i = 0; i < artists.Count; i++)
                    {
                        var artist = artists[i];
                        <article class="entry-card" data-entry-card data-entry-name="@artist.Name" data-entry-url="@artist.Url" data-yaml-index="@i">
                            <div class="entry-copy">
                                <h3>@artist.Name</h3>
                                @if (IndexModel.IsClickableTrackingUrl(artist.Url))
                                {
                                    <a href="@artist.Url" target="_blank" rel="noopener noreferrer">@artist.Url</a>
                                }
                                else
                                {
                                    <span>@artist.Url</span>
                                }
                                <span class="metadata"><span class="dot @(artist.Refresh ? "dot-on" : "dot-off")"></span>Update automatically: @(artist.Refresh ? "yes" : "no")</span>
                            </div>
                            <div class="entry-actions">
                                <button type="button" data-open-editor data-entry-type="Artist" data-index="@i" data-name="@artist.Name" data-url="@artist.Url" data-refresh="@artist.Refresh.ToString().ToLowerInvariant()">Edit</button>
                                <button class="danger" type="button" data-open-delete data-entry-type="Artist" data-index="@i" data-name="@artist.Name" data-url="@artist.Url">Delete</button>
                            </div>
                        </article>
                    }
                    </div>
                </form>
            </section>

            <section class="tab-panel" data-tab-panel="playlists" role="tabpanel">
                <div class="section-header">
                    <div>
                        <h2>Playlists</h2>
                        <p>Track Spotify playlists and keep their songs organized under your playlist folders.</p>
                        <div class="order-toolbar" aria-label="Playlist order">
                            <div class="order-toggle-row">
                                <span>Order:</span>
                                <span>A-Z</span>
                                <label class="order-switch">
                                    <input type="checkbox" data-order-toggle checked />
                                    <span aria-hidden="true"></span>
                                </label>
                                <span>YAML</span>
                                <small><em>Drag items in YAML mode to save a new file order.</em></small>
                            </div>
                        </div>
                    </div>
                    <button class="primary-action" type="button" data-open-editor data-entry-type="Playlist">+ Add playlist</button>
                </div>

                <form method="post" asp-page-handler="Reorder" class="reorder-form" data-reorder-form data-entry-type="Playlist">
                    <input type="hidden" name="ReorderEntryType" value="Playlist" />
                    <input type="hidden" name="OrderedIndexes" data-ordered-indexes />
                    <input type="hidden" name="OrderedEntries" data-ordered-entries />
                    <div class="entry-list" data-entry-list data-entry-type="Playlist">
                    @if (playlists.Count == 0)
                    {
                        <p class="empty-state">No tracked playlists yet.</p>
                    }
                    @for (var i = 0; i < playlists.Count; i++)
                    {
                        var playlist = playlists[i];
                        <article class="entry-card" data-entry-card data-entry-name="@playlist.Name" data-entry-url="@playlist.Url" data-yaml-index="@i">
                            <div class="entry-copy">
                                <h3>@playlist.Name</h3>
                                @if (IndexModel.IsClickableTrackingUrl(playlist.Url))
                                {
                                    <a href="@playlist.Url" target="_blank" rel="noopener noreferrer">@playlist.Url</a>
                                }
                                else
                                {
                                    <span>@playlist.Url</span>
                                }
                                <span class="metadata"><span class="dot @(playlist.Refresh ? "dot-on" : "dot-off")"></span>Update automatically: @(playlist.Refresh ? "yes" : "no") · @IndexModel.GetPlaylistModeLabel(playlist.Mode)</span>
                            </div>
                            <div class="entry-actions">
                                <button type="button" data-open-editor data-entry-type="Playlist" data-index="@i" data-name="@playlist.Name" data-url="@playlist.Url" data-refresh="@playlist.Refresh.ToString().ToLowerInvariant()" data-mode="@playlist.Mode">Edit</button>
                                <button class="danger" type="button" data-open-delete data-entry-type="Playlist" data-index="@i" data-name="@playlist.Name" data-url="@playlist.Url">Delete</button>
                            </div>
                        </article>
                    }
                    </div>
                </form>
            </section>
        </section>
    </main>

    <dialog class="modal" id="entry-modal">
        <form method="post" asp-page-handler="Save" class="modal-card">
            <input type="hidden" asp-for="Entry.EntryType" id="entry-type" />
            <input type="hidden" asp-for="Entry.Index" id="entry-index" />
            <input type="hidden" asp-for="Entry.OriginalName" id="entry-original-name" />
            <input type="hidden" asp-for="Entry.OriginalUrl" id="entry-original-url" />
            <input type="hidden" asp-for="Entry.OriginalRefresh" id="entry-original-refresh" />
            <input type="hidden" asp-for="Entry.OriginalMode" id="entry-original-mode" />
            <header class="modal-header">
                <h2 id="entry-modal-title">Add entry</h2>
                <button type="button" class="ghost icon-button" data-close-modal aria-label="Close dialog">×</button>
            </header>
            <label>
                Name
                <span class="field-hint" id="entry-name-hint">A friendly folder name for this tracked item.</span>
                <input asp-for="Entry.Name" id="entry-name" autocomplete="off" required />
            </label>
            <label>
                URL
                <span class="field-hint" id="entry-url-hint">Paste the Spotify URL exactly as it appears in your browser.</span>
                <input asp-for="Entry.Url" id="entry-url" type="url" required />
            </label>
            <label class="checkbox-row">
                <input asp-for="Entry.Refresh" id="entry-refresh" checked />
                <span>
                    Update automatically
                    <small>When enabled, the scheduled downloader checks this item again. Turn it off to keep already-downloaded music untouched.</small>
                </span>
            </label>
            <label id="mode-field">
                Playlist updates
                <select asp-for="Entry.Mode" id="entry-mode">
                    <option value="Full">Mirror Spotify and remove deleted songs</option>
                    <option value="Add">Download new songs only</option>
                </select>
            </label>
            <footer class="modal-actions">
                <button type="submit" class="primary-action">Save</button>
            </footer>
        </form>
    </dialog>

    <dialog class="modal" id="delete-modal">
        <form method="post" asp-page-handler="Delete" class="modal-card">
            <input type="hidden" asp-for="DeleteEntryType" id="delete-entry-type" />
            <input type="hidden" asp-for="DeleteIndex" id="delete-index" />
            <input type="hidden" asp-for="DeleteOriginalName" id="delete-original-name" />
            <input type="hidden" asp-for="DeleteOriginalUrl" id="delete-original-url" />
            <header class="modal-header">
                <h2>Remove entry?</h2>
                <button type="button" class="ghost icon-button" data-close-modal aria-label="Close dialog">×</button>
            </header>
            <p id="delete-copy" class="delete-copy"></p>
            <footer class="modal-actions">
                <button type="submit" class="danger primary-danger">Confirm delete</button>
            </footer>
        </form>
    </dialog>

    <script src="~/js/tracking.js" asp-append-version="true"></script>
</body>
</html>
